NODE_ENV=development
PORT=3100
API_PREFIX=v1

# Replica set de un nodo levantado con `pnpm db:up` (ver docker-compose.yml).
MONGODB_URI=mongodb://localhost:27017/restaurants?replicaSet=rs0

# Orígenes permitidos, separados por coma. Vacío: nadie cruza desde un navegador.
CORS_ORIGINS=

# Firma los tokens del equipo. Mínimo 32 caracteres; en producción, uno largo y aleatorio
# (`openssl rand -base64 48`).
JWT_SECRET=solo-para-desarrollo-cambiar-en-produccion-123
JWT_TTL=12h

# Fotos de la carta: `local` (disco, servidas por la API) o `s3` (R2, S3, MinIO).
STORAGE_DRIVER=local
MEDIA_DIR=media
MEDIA_PUBLIC_URL=http://localhost:3100/media
# Solo con STORAGE_DRIVER=s3:
# S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://fotos.ejemplo.co
