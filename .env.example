NODE_ENV=development
PORT=3100
API_PREFIX=v1

# Replica set de un nodo levantado con `pnpm db:up` (ver docker-compose.yml).
MONGODB_URI=mongodb://localhost:27017/restaurants?replicaSet=rs0

# Orígenes permitidos, separados por coma. Vacío: nadie cruza desde un navegador.
CORS_ORIGINS=

# Firma los tokens del equipo. Mínimo 32 caracteres; en producción, uno largo y aleatorio
# (`openssl rand -base64 48`).
JWT_SECRET=solo-para-desarrollo-cambiar-en-produccion-123
JWT_TTL=12h
